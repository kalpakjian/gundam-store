# Django 環境變數（複製為 .env 後填入）
#
# 注意：本專案為內部協作 demo，實際的 .env（含 Cloudinary 憑證）
# 已刻意提交到 repo，方便團隊成員共用同一個 Cloudinary 帳戶上傳圖片。
# 部署時請確認 .env 內容正確。

SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1

# Cloudinary（圖片儲存，讓 Django 部署保持輕量）
# 團隊共用帳戶：cloud name = dlxghvxpf
CLOUDINARY_CLOUD_NAME=dlxghvxpf
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
